local targetLabel = statusBox:AddLabel("Targeting: None")

local function aliveEnemy(e)
    local h = e:FindFirstChild("Humanoid")
    return h and h.Health > 0
end

local function enemyRoot(e)
    return e:FindFirstChild("HumanoidRootPart") or e:FindFirstChild("UpperTorso") or e:FindFirstChild("Torso")
end

local function countAlive()
    if isDungeonMap() then
        local dungeon = workspace:FindFirstChild("dungeon")
        if not dungeon then return 0 end
        local count = 0
        for _, room in ipairs(dungeon:GetChildren()) do
            local ef = room:FindFirstChild("enemyFolder")
            if ef then
                for _, e in ipairs(ef:GetChildren()) do
                    if aliveEnemy(e) then count += 1 end
                end
            end
        end
        return count
    end

    local enemies = workspace:FindFirstChild("enemies")
    if not enemies then return 0 end
    local count = 0
    for _, e in ipairs(enemies:GetChildren()) do
        if aliveEnemy(e) then count += 1 end
    end
    return count
end

local function getTarget(hrp)
    if isDungeonMap() then
        local dungeon = workspace:FindFirstChild("dungeon")
        if not dungeon then return end

        local bestRoom, bestRoomDist
        for _, room in ipairs(dungeon:GetChildren()) do
            local ef = room:FindFirstChild("enemyFolder")
            if ef then
                local nearestInRoom
                for _, e in ipairs(ef:GetChildren()) do
                    if aliveEnemy(e) then
                        local root = enemyRoot(e)
                        if root then
                            local d = (root.Position - hrp.Position).Magnitude
                            if not nearestInRoom or d < nearestInRoom then
                                nearestInRoom = d
                            end
                        end
                    end
                end
                if nearestInRoom and (not bestRoomDist or nearestInRoom < bestRoomDist) then
                    bestRoomDist = nearestInRoom
                    bestRoom = room
                end
            end
        end
        if not bestRoom then return end

        local ef = bestRoom.enemyFolder
        local bestE, bestD
        for _, e in ipairs(ef:GetChildren()) do
            if aliveEnemy(e) then
                local root = enemyRoot(e)
                if root then
                    local d = (root.Position - hrp.Position).Magnitude
                    if not bestD or d < bestD then
                        bestD = d
                        bestE = e
                    end
                end
            end
        end
        return bestE
    end

    local enemies = workspace:FindFirstChild("enemies")
    if not enemies then return end
    local bestE, bestD
    for _, e in ipairs(enemies:GetChildren()) do
        if aliveEnemy(e) then
            local root = enemyRoot(e)
            if root then
                local d = (root.Position - hrp.Position).Magnitude
                if not bestD or d < bestD then
                    bestD = d
                    bestE = e
                end
            end
        end
    end
    return bestE
end

local function findFireEvent(tool)
    local direct = tool:FindFirstChildOfClass("RemoteEvent")
    if direct then return direct end

    for _, desc in ipairs(tool:GetDescendants()) do
        if desc:IsA("RemoteEvent") then
            return desc
        end
    end

    return nil
end

local function fireAbilities(distanceToTarget)
    if #selectedAbilities ~= 2 then
        return
    end

    if not distanceToTarget or distanceToTarget > abilityRange then
        return
    end

    for i, label in ipairs(selectedAbilities) do
        local tool = abilityToolMap[label]
        if tool and tool.Parent then
            local delay = (i == 1) and skill1Delay or skill2Delay
            local last = lastAbilityFire[tool] or 0
            if tick() - last >= delay then
                local event = findFireEvent(tool)
                if event then
                    event:FireServer()
                    lastAbilityFire[tool] = tick()
                end
            end
        end
    end
end

rs.Heartbeat:Connect(function(dt)
    aliveLabel:SetText("Enemies Alive: " .. countAlive())

    if not farm then
        currentTarget = nil
        targetLabel:SetText("Targeting: None")
        if currentTween then
            currentTween:Cancel()
            currentTween = nil
        end
        orbitInitialized = false
        return
    end

    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local target = getTarget(hrp)
    currentTarget = target
    targetLabel:SetText("Targeting: " .. (target and target.Name or "None"))

    if not target then
        if currentTween then
            currentTween:Cancel()
            currentTween = nil
        end
        orbitInitialized = false
        resetPath()
        return
    end

    local root = enemyRoot(target)
    if not root then return end

    local head = target:FindFirstChild("Head") or target:FindFirstChild("head")
    local headY = head and head.Position.Y or (root.Position.Y + 3)

    local groundY = getGroundY(root.Position, target)
    local distanceToTarget = horizontalDistance(hrp.Position, root.Position)

    if autoAbility then
        fireAbilities(distanceToTarget)
    end

    local torso = target:FindFirstChild("UpperTorso") or target:FindFirstChild("Torso") or root

    local pos
    if orbitEnabled then
        if not orbitInitialized then
            local rel = hrp.Position - root.Position
            orbitAngle = math.deg(math.atan2(rel.Z, rel.X))
            orbitInitialized = true
        end
        orbitAngle = orbitAngle + orbitSpeed * dt
        local angleRad = math.rad(orbitAngle)
        local offset = Vector3.new(math.cos(angleRad) * orbitRadius, 0, math.sin(angleRad) * orbitRadius)
        pos = Vector3.new(root.Position.X, headY + oy, root.Position.Z) + offset
    else
        orbitInitialized = false
        pos = Vector3.new(root.Position.X + ox, headY + oy, root.Position.Z + oz)
    end

    if autoPath then
        local closeDist = orbitEnabled and (orbitRadius + 4) or 8

        if distanceToTarget > closeDist then
            if pathTarget ~= target then
                pathTarget = target
                pathWaypoints = {}
                pathIndex = 1
                computePath(hrp.Position, Vector3.new(root.Position.X, groundY, root.Position.Z))
            elseif tick() - lastPathCompute >= pathRecomputeDelay then
                computePath(hrp.Position, Vector3.new(root.Position.X, groundY, root.Position.Z))
            end

            local wp = pathWaypoints[pathIndex]
            if wp then
                local flatHrp = Vector3.new(hrp.Position.X, 0, hrp.Position.Z)
                local flatWp = Vector3.new(wp.Position.X, 0, wp.Position.Z)
                if (flatHrp - flatWp).Magnitude < 2 and pathIndex < #pathWaypoints then
                    pathIndex += 1
                    wp = pathWaypoints[pathIndex]
                end
            end
            if wp then
                pos = wp.Position + Vector3.new(0, 3, 0)
            end
        else
            pathWaypoints = {}
            pathIndex = 1
        end
    end

    local maxDist = math.max(farmSpeed, 0) * dt
    local newPos = moveTowards(hrp.Position, pos, maxDist)

    local newCFrame
    if tilt then
        -- Snaps directly and applies a -50 degree pitch tilt toward the target
        newCFrame = CFrame.new(newPos, torso.Position) * CFrame.Angles(math.rad(-50), 0, 0)
    elseif orbitEnabled then
        newCFrame = CFrame.new(newPos, torso.Position)
    else
        newCFrame = CFrame.new(newPos)
    end

    if farmMethod == "CFrame" then
        if currentTween then
            currentTween:Cancel()
            currentTween = nil
        end
        hrp.CFrame = newCFrame
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

    elseif farmMethod == "Tween" then
        if currentTween then
            currentTween:Cancel()
        end
        currentTween = TweenService:Create(hrp, TweenInfo.new(dt, Enum.EasingStyle.Linear), {CFrame = newCFrame})
        currentTween:Play()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    if attack and tick() - lastHit >= atkDelay then
        local weaponVal = lp:FindFirstChild("weaponEquipped")
        local swordName = weaponVal and weaponVal.Value
        local tool = swordName and char:FindFirstChild(swordName)
        local ev = tool and tool:FindFirstChild("swing")
        if ev then
            ev:FireServer()
            lastHit = tick()
        end
    end
end)

