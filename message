local function getBackpackAbilityLabels()
    local labels = {}
    local nameCounts = {}
    abilityToolMap = {}

    local function addTool(tool)
        if not tool:IsA("Tool") then return end

        nameCounts[tool.Name] = (nameCounts[tool.Name] or 0) + 1

        local label = tool.Name
        if nameCounts[tool.Name] > 1 then
            label = tool.Name .. " (" .. nameCounts[tool.Name] .. ")"
        end

        table.insert(labels, label)
        abilityToolMap[label] = tool
    end

    local backpack = lp:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            addTool(tool)
        end
    end

    local char = lp.Character
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            addTool(tool)
        end
    end

    return labels
end

