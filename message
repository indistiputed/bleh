local AbilityDropdown = abilityBox:AddDropdown("ability_dropdown", {
    Values = getBackpackAbilityLabels(),
    Multi = true,
    Default = {},
    Text = "Select 2 Abilities",
    Callback = function(selected)
        local newSet = {}

        if typeof(selected) == "table" then
            if selected[1] ~= nil then
                for _, label in ipairs(selected) do
                    newSet[label] = true
                end
            else
                for label, isSelected in pairs(selected) do
                    if isSelected then
                        newSet[label] = true
                    end
                end
            end
        end

        for i = #selectedAbilities, 1, -1 do
            local label = selectedAbilities[i]
            if not newSet[label] then
                table.remove(selectedAbilities, i)
            else
                newSet[label] = nil
            end
        end

        for label in pairs(newSet) do
            table.insert(selectedAbilities, label)
        end
    end
})

