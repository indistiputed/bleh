local function isDungeonMap()
    local dungeon = workspace:FindFirstChild("dungeon")
    if not dungeon then
        return false
    end

    for _, child in ipairs(dungeon:GetChildren()) do
        if child.Name:lower():match("^room") then
            return true
        end
    end

    return #dungeon:GetChildren() > 0
end

local function startNoclip()
    if noclipConnection then return end
    noclipConnection = rs.Stepped:Connect(function()
        local char = lp.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)
end

local function stopNoclip()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    local char = lp.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

local function updateNoclipState()
    if farm and not autoPath then
        startNoclip()
    else
        stopNoclip()
    end
end

local function resetPath()
    pathWaypoints = {}
    pathIndex = 1
    pathTarget = nil
    lastPathCompute = 0
end

local function computePath(startPos, endPos)
    if pathComputing then return end
    pathComputing = true
    task.spawn(function()
        local path = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            WaypointSpacing = 4,
        })
        local ok = pcall(function()
            path:ComputeAsync(startPos, endPos)
        end)
        if ok and path.Status == Enum.PathStatus.Success then
            pathWaypoints = path:GetWaypoints()
            pathIndex = math.min(2, #pathWaypoints)
        else
            pathWaypoints = {}
            pathIndex = 1
        end
        lastPathCompute = tick()
        pathComputing = false
    end)
end

local function moveTowards(current, target, maxDistance)
    local diff = target - current
    local dist = diff.Magnitude
    if dist <= maxDistance or dist == 0 then
        return target
    end
    return current + diff.Unit * maxDistance
end

local function horizontalDistance(a, b)
    return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

local function getGroundY(position, ignoreInstance)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local filter = {}
    if ignoreInstance then table.insert(filter, ignoreInstance) end
    if lp.Character then table.insert(filter, lp.Character) end
    rayParams.FilterDescendantsInstances = filter

    local rayResult = workspace:Raycast(position, Vector3.new(0, -1000, 0), rayParams)

    if rayResult then
        return rayResult.Position.Y
    end

    return position.Y
end

